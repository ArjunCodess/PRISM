# Copy this file to apps/web/.env.local for local Next.js, or set the
# same name in Vercel / your host. Next inlines NEXT_PUBLIC_* at build time.

# Live FastAPI origin. No trailing slash.
# Production website requires this. The six cases and the lab load from
# the API, and each case page runs POST /v1/risk/predict.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
